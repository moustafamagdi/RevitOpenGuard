<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RevitOpenGuard</AssemblyName>
    <RootNamespace>RevitOpenGuard</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>0.1.0</Version>
    <Authors>Mostafa Magdy</Authors>
    <Description>Opening-scoped handling of known Revit dialogs and recoverable failures.</Description>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == ''">C:\Program Files\Autodesk\Revit 2024</RevitInstallPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <Target Name="CheckRevitReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(RevitInstallPath)\RevitAPI.dll') Or !Exists('$(RevitInstallPath)\RevitAPIUI.dll')"
           Text="Revit 2024 API assemblies were not found. Install Revit 2024 or set RevitInstallPath to its installation directory." />
  </Target>
</Project>
