<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitYear Condition="'$(RevitYear)' == ''">2024</RevitYear>
    <TargetFramework Condition="$(RevitYear) &lt;= 2024">net48</TargetFramework>
    <TargetFramework Condition="$(RevitYear) == 2025 Or $(RevitYear) == 2026">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitYear) == 2027">net10.0-windows</TargetFramework>
    <DefineConstants Condition="$(RevitYear) &lt;= 2023">$(DefineConstants);REVIT_LEGACY_IDS</DefineConstants>
    <BaseOutputPath>bin\$(RevitYear)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RevitOpenGuard</AssemblyName>
    <RootNamespace>RevitOpenGuard</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>0.2.2</Version>
    <AssemblyVersion>0.2.$(RevitYear).2</AssemblyVersion>
    <Authors>Mostafa Magdy</Authors>
    <Description>Opening-scoped handling of known Revit dialogs and recoverable failures.</Description>
    <RevitApiVersion Condition="$(RevitYear) == 2022">2022.1.1</RevitApiVersion>
    <RevitApiVersion Condition="$(RevitYear) == 2023">2023.0.1</RevitApiVersion>
    <RevitApiVersion Condition="$(RevitYear) == 2024">2024.0.0</RevitApiVersion>
    <RevitApiVersion Condition="$(RevitYear) == 2025">2025.0.2</RevitApiVersion>
    <RevitApiVersion Condition="$(RevitYear) == 2026">2026.0.4</RevitApiVersion>
    <RevitApiVersion Condition="$(RevitYear) == 2027">2027.0.0</RevitApiVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(RevitInstallPath)' != ''">
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RevitInstallPath)' == ''">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\catalog\catalog.json" LogicalName="OpenGuard.Catalog" />
    <EmbeddedResource Include="..\catalog\public-key.xml" LogicalName="OpenGuard.PublicKey" />
  </ItemGroup>
  <Target Name="CheckRevitReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(DesignTimeBuild)' != 'true' And '$(RevitInstallPath)' != ''">
    <Error Condition="!Exists('$(RevitInstallPath)\RevitAPI.dll') Or !Exists('$(RevitInstallPath)\RevitAPIUI.dll')"
           Text="Revit API assemblies were not found in RevitInstallPath." />
  </Target>
  <Target Name="ValidateRevitYear" BeforeTargets="PrepareForBuild">
    <Error Condition="$(RevitYear) &lt; 2022 Or $(RevitYear) &gt; 2027" Text="Supported Revit years: 2022 through 2027." />
  </Target>
</Project>
