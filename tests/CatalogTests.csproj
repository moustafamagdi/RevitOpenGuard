<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType>
  <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
  <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
  <PlatformTarget>x64</PlatformTarget>
 </PropertyGroup>
 <ItemGroup>
  <Compile Include="..\RevitOpenGuard\Policies\Catalog.cs" Link="Catalog.cs" />
  <Compile Include="..\RevitOpenGuard\Infrastructure\CatalogStore.cs" Link="CatalogStore.cs" />
  <Compile Include="..\RevitOpenGuard\Infrastructure\AuditLog.cs" Link="AuditLog.cs" />
  <EmbeddedResource Include="..\catalog\catalog.json" LogicalName="OpenGuard.Catalog" />
  <EmbeddedResource Include="..\catalog\public-key.xml" LogicalName="OpenGuard.PublicKey" />
 </ItemGroup>
 <ItemGroup Condition="'$(TargetFramework)'=='net48'">
  <Reference Include="System.Runtime.Serialization" /><Reference Include="System.Net.Http" />
 </ItemGroup>
</Project>
