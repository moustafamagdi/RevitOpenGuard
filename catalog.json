{
  "schemaVersion": 1,
  "version": "1.0.3",
  "minToolVersion": "0.2.0",
  "notes": "Adds a Revit 2024 English recovery rule for \"The Tap must be attached to duct.\" During model opening, Open Guard requests deletion of the affected elements only when Revit permits DeleteElements. Review the model before Save or Sync. Existing recovery rules are preserved.",
  "rules": [
    {
      "id": "Text.UnattachedDuctTap.DeleteElements",
      "kind": "Failure",
      "allText": [
        "the tap must be attached to duct"
      ],
      "action": "DeleteElements",
      "minRevit": 2024,
      "maxRevit": 2024
    },
    {
      "id": "Text.InvalidDimensionReferences.DeleteDimensions",
      "kind": "Failure",
      "allText": [
        "one or more dimension references are or have become invalid"
      ],
      "action": "DeleteElements",
      "minRevit": 2024,
      "maxRevit": 2024
    },
    {
      "id": "Dimension.LinearConstraintNotParallel",
      "kind": "Failure",
      "failureId": "BuiltIn:LinearConstraintNotParallel",
