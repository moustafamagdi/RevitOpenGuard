      "minRevit": 2022,
      "maxRevit": 2027
    },
    {
      "id": "Text.BrokenAnnotationReference",
      "kind": "Failure",
      "anyText": [
        "reference is no longer",
        "references are no longer",
        "reference is missing",
        "references are missing",
        "missing reference",
